# ── Server environment variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quickbite?retryWrites=true&w=majority

# JWT secret — any long random string
JWT_SECRET=quickbite_super_secret_jwt_key_2024

# JWT expiry
JWT_EXPIRE=7d

# Razorpay test keys — get from https://dashboard.razorpay.com (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
